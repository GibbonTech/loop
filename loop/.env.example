VITE_BASE_URL=http://localhost:3000

# Database - Docker PostgreSQL
DATABASE_URL="postgresql://loop:loop_dev_password@localhost:5432/loop"

# Better Auth - Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ============================================
# EMAIL - Resend (https://resend.com)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxx

# ============================================
# FILE STORAGE - Cloudflare R2
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=driivo-files
# Optional: secret for signed CDN URLs (generate with: openssl rand -base64 32)
R2_SIGNING_SECRET=
# Optional: custom domain for file proxy worker
R2_CDN_BASE=https://files.driivo.fr

# ============================================
# ANALYTICS - Google Analytics 4 (optional)
# ============================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
